    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "ts-morph": "^21.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "ff": "0.2.2",
    "typescript": "^5.3.3",
    "vitest": "^1.1.3"
  }
}
